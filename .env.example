# 湛箴配置样例 —— 复制为 .env 使用；真实密钥绝不入 Git（spec §12）
ZZ_DATA_DIR=./data
ZZ_TENANT_ID=demo-tenant
ZZ_REVIEW_THRESHOLD=0.80

# AI 助手（可选，默认关闭；OpenAI 兼容端点均可）
# NVIDIA 免费: https://integrate.api.nvidia.com/v1
# ZZ_AI_BASE_URL=https://integrate.api.nvidia.com/v1
# ZZ_AI_API_KEY=nvapi-xxx
# ZZ_AI_MODEL=nvidia/nemotron-3-super-120b-a12b
